{
  "name": "yamaha-psr-drum-simulator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:standalone": "npm run build && node scripts/build-standalone.js && node Diagnostics/check_standalone.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:adapters": "node scripts/build-adapters.mjs",
    "precli": "npm run build:adapters",
    "cli": "node scripts/groove-cli.mjs",
    "premcp": "npm run build:adapters",
    "mcp": "node scripts/groove-mcp.mjs",
    "diagnostics": "python3 Diagnostics/check_feature_parity.py && python3 Diagnostics/check_samples.py",
    "test:adapters": "npm run build:adapters && node scripts/check-adapters.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
